{
  "mcpServers": {
    "windows-server-search": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/server/server.ps1"
      ],
      "env": {
        "WSS_SERVERS": "${user_config.servers}",
        "WSS_AUTO_DISCOVER": "${user_config.auto_discover}",
        "WSS_EXCLUDE": "${user_config.exclude}",
        "WSS_MAX_RESULTS": "${user_config.max_results}",
        "WSS_DOWNLOAD_DIR": "${user_config.download_dir}",
        "WSS_DENY": "${user_config.deny_paths}",
        "WSS_WRITE_ENABLED": "${user_config.allow_write}",
        "WSS_WRITE_OVERWRITE": "${user_config.allow_overwrite}",
        "WSS_WRITE_BACKUP": "${user_config.keep_backups}",
        "WSS_WRITE_DELETE": "${user_config.allow_delete}"
      }
    }
  }
}
